PORT=4000
NODE_ENV=development
MAX_FILE_SIZE_MB=10

# Seed the 12 sample photos on boot when the gallery is empty (Render, Docker).
# Set to false to start with an empty gallery.
AUTO_SEED=true

# Folder for the SQLite database and the uploaded images. Leave unset for
# local development. On Render, set this to the mount path of a Persistent Disk
# (e.g. /var/data) so data survives restarts and redeploys.
# DATA_DIR=/var/data

# Individual overrides (they win over DATA_DIR). The test suite uses these to
# stay isolated from the real data.
# DB_PATH=./database/photovault.sqlite
# UPLOAD_DIR=./uploads
